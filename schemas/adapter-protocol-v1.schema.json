            "graceful": {
              "const": true
            },
            "mechanism": {
              "const": "control_file"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "graceful",
            "mechanism"
          ],
          "properties": {
            "graceful": {
              "const": false
            },
            "mechanism": {
              "const": "none"
