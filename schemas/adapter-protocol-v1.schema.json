    "responseEnvelope": {
      "type": "object",
      "required": [
        "protocol",
        "protocol_version",
        "request_id",
        "operation",
        "status",
        "artifacts"
      ],
      "properties": {
        "protocol": {
          "const": "zkperf-adapter"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "operation": {
          "enum": [
            "capabilities",
            "metadata",
            "prepare",
            "execute",
            "prove",
            "verify"
          ]
        },
        "status": {
          "enum": [
            "success",
            "unsupported",
            "error"
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/failure"
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": {
                  "const": "success"
                }
              },
              "required": [
                "result"
              ],
              "not": {
                "required": [
                  "error"
                ]
              }
            },
            {
              "properties": {
                "status": {
                  "enum": [
                    "unsupported",
                    "error"
                  ]
                }
              },
              "required": [
                "error"
              ],
              "not": {
                "required": [
                  "result"
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "capabilities"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/capabilitiesResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "metadata"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/metadataResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "prepare"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/prepareResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "execute"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/executeResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "prove"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/proveResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "verify"
              },
              "status": {
                "const": "success"
              }
            },
            "required": [
              "operation",
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/verifyResult"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
