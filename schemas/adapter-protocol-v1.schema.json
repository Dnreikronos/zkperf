      "type": "object",
      "required": [
        "phase",
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "phase": {
          "enum": [
            "protocol",
            "capabilities",
            "metadata",
            "preparation",
            "build",
            "setup",
            "execution",
            "proving",
            "compression",
            "verification",
            "artifact",
            "cleanup"
          ]
        },
