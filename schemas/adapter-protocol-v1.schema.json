        "public_values_artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "commitment_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "transform"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "transformation_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "transformation_id"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
