        "operations": {
          "type": "object",
          "required": [
            "capabilities",
            "metadata",
            "prepare",
            "execute",
            "prove",
            "verify"
          ],
          "properties": {
            "capabilities": {
              "$ref": "#/$defs/operationCapability"
            },
            "metadata": {
              "$ref": "#/$defs/operationCapability"
            },
            "prepare": {
              "$ref": "#/$defs/prepareCapability"
            },
            "execute": {
              "$ref": "#/$defs/operationCapability"
            },
            "prove": {
              "$ref": "#/$defs/proveCapability"
            },
            "verify": {
              "$ref": "#/$defs/operationCapability"
            }
          },
          "additionalProperties": false
        },
        "measurement_boundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/measurementBoundary"
          }
        },
        "proof_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proofMode"
          }
        },
        "cancellation": {
          "$ref": "#/$defs/cancellationCapability"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operations": {
                "properties": {
                  "prove": {
                    "properties": {
                      "supported": {
                        "const": true
                      }
                    },
                    "required": [
                      "supported"
                    ]
                  }
                },
                "required": [
                  "prove"
                ]
              }
            },
            "required": [
              "operations"
            ]
          },
          "then": {
            "properties": {
              "proof_modes": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
