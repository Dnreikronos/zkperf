      ],
      "properties": {
        "max_protocol_stdout_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_artifact_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
