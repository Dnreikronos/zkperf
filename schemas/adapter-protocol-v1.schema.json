    "proveResult": {
      "type": "object",
      "required": [
        "stage",
        "proof_mode_id",
        "proof_artifact_id",
        "commitment_digests",
        "observations"
      ],
      "properties": {
        "stage": {
          "enum": [
            "initial",
            "transform"
          ]
        },
        "proof_mode_id": {
          "$ref": "#/$defs/identifier"
